# Variables synchronisees par l'integration Supabase/Vercel.
SUPABASE_URL=https://your-project.supabase.co
# Server only. Never expose this key in browser code.
SUPABASE_SECRET_KEY=replace-with-secret-key
# Public key returned by /api/config for future browser auth.
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Legacy SUPABASE_SERVICE_ROLE_KEY and SUPABASE_ANON_KEY remain supported.

# Production URL, with HTTPS and without a trailing slash.
PUBLIC_APP_ORIGIN=https://your-domain.example
