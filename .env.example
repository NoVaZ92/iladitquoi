# Vercel server-side variables. Never expose the service role key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# This key is intentionally public and can be returned by /api/config for future browser auth.
SUPABASE_ANON_KEY=replace-with-anon-key

# Production URL, with HTTPS and without a trailing slash.
PUBLIC_APP_ORIGIN=https://your-domain.example
