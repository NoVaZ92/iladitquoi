{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/finalized.html" },
    { "source": "/connexion", "destination": "/auth.html" },
    { "source": "/compte", "destination": "/profile.html" },
    { "source": "/profil", "destination": "/profile.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/regles", "destination": "/rules.html" },
    { "source": "/cgu", "destination": "/legal.html" },
    { "source": "/confidentialite", "destination": "/legal.html" },
    { "source": "/mentions-legales", "destination": "/legal.html" },
    { "source": "/a/:id", "destination": "/?anecdote=:id" },
    { "source": "/p/:token", "destination": "/?private=:token" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/ready", "destination": "/api/health?ready=1" },
    { "source": "/api/configuration", "destination": "/api/config" },
    { "source": "/api/vote", "destination": "/api/report?action=vote" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; font-src 'self' data:; upgrade-insecure-requests" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
